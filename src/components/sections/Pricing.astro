---
import Testimonial from "../ui/Testimonial.astro";
import { testimonials } from "../../data/testimonials";
import Icon from "../ui/Icon.astro";
---
<section class="section_price">
<div class="grid_global is-full">
<div class="grid_item is-side is-left"></div>
<div class="grid_item is-central">
<div class="price_wrap">
<div class="div-block-40">
<div class="highlight_capsule">
<div class="is-highlight-capsule">design subscription</div>
</div>
<div class="div-block-30">
<div class="price-card_wrap is-new">
<div class="div-block-24 is-new">
<div class="icon_heart w-embed"><Icon name="heart" /></div>
<div>Start Today</div>
</div>
<div class="div-block-54">
<div class="div-block-26 is-new">
<h3 class="heading-5 is-new">Fractional Designer</h3>
</div>
<div class="spacer-small"></div>
<div class="heading_purple_wrap is-price">
<div class="div-block-53">
<h2 class="heading-3 is-new">€1995 EUR</h2>
</div>
<div>/month</div>
</div>
</div>
<div class="div-block-25 is-new">
<h2 class="heading-4 is-new">€1995</h2>
<div>/month</div>
</div>
<div class="spacer-small"></div>
<p class="p-small is-normal is-hourly is-new">Best for founders &amp; startups who need ongoing design and strategy support without hiring full-time.<br/><br/>What you get:</p>
<div class="div-block-27 is-new">
<div class="impact_capsule is-book is-price is-new">
<div class="icon_circled-arrow is-item w-embed"><Icon name="circled-arrow" /></div>
<div>Senior-level expertise</div>
</div>
<div class="impact_capsule is-book is-price is-new">
<div class="icon_circled-arrow is-item w-embed"><Icon name="circled-arrow" /></div>
<div>Unlimited requests (one a time)</div>
</div>
<div class="impact_capsule is-book is-price is-new">
<div class="icon_circled-arrow is-item w-embed"><Icon name="circled-arrow" /></div>
<div>Avg. 72 hour delivery (new daddy)</div>
</div>
<div class="impact_capsule is-book is-price is-new">
<div class="icon_circled-arrow is-item w-embed"><Icon name="circled-arrow" /></div>
<div>Strategy, Design, Webflow dev</div>
</div>
<div class="impact_capsule is-book is-price is-new">
<div class="icon_circled-arrow is-item w-embed"><Icon name="circled-arrow" /></div>
<div>Pause or cancel anytime</div>
</div>
</div>
<div class="spacer-medium"></div>
<div class="div-block-28">
<a class="btn_primary is-start is-new w-inline-block" href="https://buy.stripe.com/7sY5kFcshdCI4sW4yW5Ne00" target="_blank"><img alt="A man with a beard and short hair is smiling at the camera against a dark background. He wears a simple black shirt and has a beaded necklace." class="img_profile is-mattia is-hide" loading="lazy" sizes="(max-width: 636px) 100vw, 636px" src="/images/profile.webp" srcset="/images/profile-p-500.webp 500w, /images/profile.webp 636w"/>
<div class="btn-txt_wrap">
<div class="btn-headingg-wrap is-start">
<div class="txt-btn-primary is-start is-new">Start today</div>
</div>
<div class="btn-subtxt-wrap is-start is-new">
<div>Zero regrets, promise!</div>
</div>
</div>
</a>
<div class="div-block-59">
<div class="div-block-29">
<div class="text-block-3">1 of 4 slots available</div>
</div>
</div>
</div>
</div>
<div class="price-rev_wrap">
<div class="price-card_wrap is-hour">
<div class="div-block-25">
<h2 class="heading-4 is-hour">€100</h2>
<div>/hour</div>
</div>
<div class="spacer-small"></div>
<div class="div-block-26 is-hour">
<h3 class="h3_hourly">Project Based</h3>
</div>
<p class="p-small is-normal is-hourly">Best for one-off projects where you need a senior designer to ship something specific.</p>
<div class="spacer-small"></div>
<div class="div-block-27">
<div class="impact_capsule is-book">
<div class="icon_arrow-price is-reverse w-embed"><Icon name="impact-2" /></div>
<div>Pay only for the time you need</div>
</div>
<div class="impact_capsule is-book">
<div class="icon_arrow-price is-reverse w-embed"><Icon name="impact-2" /></div>
<div>Senior-level expertise</div>
</div>
<div class="impact_capsule is-book">
<div class="icon_arrow-price is-reverse w-embed"><Icon name="impact-2" /></div>
<div>Clear deliverables defined upfront</div>
</div>
</div>
<div class="spacer-medium"></div>
<div class="div-block-28">
<a class="btn_primary is-secondary w-inline-block" href="#">
<div class="btn-txt_wrap">
<div class="btn-headingg-wrap">
<div class="txt-btn-primary">Kick off your project</div>
</div>
<div class="btn-subtxt-wrap">
<div>Pause, cancel anytime.</div>
</div>
</div>
</a>
<div class="div-block-29">
<div class="text-block-3">37,700 hours before I retire</div>
</div>
</div>
</div>
<Testimonial {...testimonials["sarah-wheeler-pricing"]} variant="is-hourly is-second" ix="testimonial-card-hourly-second" star="star" />
<div class="div-block-35">
<Testimonial {...testimonials["rutger-zuurbier"]} variant="is-hourly" ix="testimonial-card-hourly" star="star" />
<Testimonial {...testimonials["annemarie-de-graaff-pricing"]} variant="is-hourly is-first" ix="testimonial-card-hourly-first" star="star" />
</div>
</div>
</div>
</div>
</div>
</div>
<div class="grid_item is-side is-right"></div>
</div>
</section>

---
import Icon from "../ui/Icon.astro";
---
<section class="section_hero">
<div class="grid_global is-hero">
<div class="grid_item is-side is-left is-hero"></div>
<div class="grid_item is-central is-pattern" >
<div class="hero_wrap">
<div class="caps-block_wrap is-hero" data-ix="caps-block-wrap-hero">
<div class="text-block-7"> I help next-gen <span class="is-highlight-capsule">FOOD &amp; DRINKS</span> founders</div>
</div>
<div class="spacer-small"></div>
<div class="hero_h1-wrap">
<h1 class="h1_hero">Design Partner</h1>
</div>
<div class="hero_h1-wrap is-mid">
<h1 class="h1_hero">to</h1>
<div class="purple-highlight_wrap is-hero" data-ix="purple-highlight-wrap-hero">
<div class="arrow_impact-data is-hero" data-ix="arrow-impact-data-hero">↑</div>
<div class="is-up-text" data-ix="up-text">up</div>
</div>
<h1 class="h1_hero is-inline is-boxed">↑up</h1>
<h1 class="h1_hero">your</h1>
</div>
<div class="hero_h1-wrap">
<h1 class="h1_hero">business</h1>
</div>
<div class="spacer-small"></div>
<div class="hero-p_wrap">
<div class="hero_p-wrap">
<p data-ix="p-i-help-founders-think-cl">I help founders think clearly and creatively. Together we nail strategy, positioning, branding <em class="italic-text">and</em> build fresh, performing websites for their business.<br/></p>
<div class="spacer-small"></div>
<p data-ix="p-results-you-can-expect-w">Results you can expect working with me:</p>
</div>
<div class="spacer-small"></div>
<div class="hero-benetifs_wrap">
<div class="impact_capsule is-hero">
<div class="icon_impact w-embed"><Icon name="impact" /></div>
<div>Boost conversion rate</div>
<div class="impact-data_wrap">
<div class="arrow_impact-data">↑</div>
<div>100-200%</div>
</div>
</div>
<div class="impact_capsule is-hero">
<div class="icon_impact w-embed"><Icon name="impact-2" /></div>
<div>Reduce bounce rate</div>
<div class="impact-data_wrap">
<div class="arrow_impact-data is-down">↑</div>
<div>20-50%</div>
</div>
</div>
<div class="impact_capsule is-hero">
<div class="icon_impact w-embed"><Icon name="impact-3" /></div>
<div>Higher engagement rate</div>
<div class="impact-data_wrap">
<div class="arrow_impact-data">↑</div>
<div>90-130%</div>
</div>
</div>
</div>
</div>
<div class="spacer-medium"></div>
<a class="btn_primary w-inline-block" data-ix="btn-primary" href="https://cal.com/mattia-cs92ne/15min" target="_blank"><img alt="A man with a beard and short hair is smiling at the camera against a black background. He is wearing a dark shirt and a wooden bead necklace." class="img_profile is-mattia" loading="lazy" sizes="(max-width: 636px) 100vw, 636px" src="/images/profile.webp" srcset="/images/profile-p-500.webp 500w, /images/profile.webp 636w"/>
<div class="btn-txt_wrap">
<div class="btn-headingg-wrap">
<div class="txt-btn-primary is-price">Book your discovery call</div>
</div>
<div class="btn-subtxt-wrap">
<div>Easy going, zero strings attached</div>
</div>
</div>
</a>
<div class="sticker is-hero">
<div>Hola I'm Mattia, Senior Designer</div>
</div>
</div>
</div>
<div class="grid_item is-side is-right is-hero" data-ix="grid-item-side-right-hero"></div>
</div>

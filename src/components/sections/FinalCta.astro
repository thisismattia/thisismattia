---
import Testimonial from "../ui/Testimonial.astro";
import { testimonials } from "../../data/testimonials";
import Icon from "../ui/Icon.astro";
---
<section class="section_book_final_cta">
<div class="grid_global">
<div class="grid_item is-side is-left"></div>
<div class="grid_item is-central">
<div class="book_wrap">
<div class="book-content_wrap">
<div class="book-top_wrap">
<div class="book-text_wrap">
<div class="spacer-xsmall"></div>
<div class="caps-block_wrap is-book-first">
<div class="text-block-7">FOR <span class="is-highlight-capsule">FOUNDERS</span> THAT NEED THEIR WEBSITE TO PERFORM</div>
</div>
<h2 class="heading-3 is-hidden">It’s time to <strong><em class="span is-highlight">upgrade</em></strong> your business.</h2>
<h2 class="heading-3">Are you ready</h2>
<div class="heading_purple_wrap">
<h2 class="heading-3">to</h2>
<div class="purple-highlight_wrap is-body">
<div>up</div>
</div>
<h2 class="heading-3">your</h2>
</div>
<h2 class="heading-3">business<span class="text-span-2">?</span></h2>
<div class="spacer-small"></div>
<div class="p_wrap book">
<p class="p-small">We’ll talk through your business, goals, challenges, and what you actually need. No fluff.</p>
</div>
<div class="hero-benetifs_wrap is-hide">
<div class="impact_capsule is-book">
<div class="icon_arrow-price w-embed"><Icon name="impact" /></div>
<div>Boost conversion rate</div>
</div>
<div class="impact_capsule is-book">
<div class="icon_arrow-price w-embed"><Icon name="impact-2" /></div>
<div>Reduce bounce rate</div>
</div>
<div class="impact_capsule is-book">
<div class="icon_arrow-price w-embed"><Icon name="impact-3" /></div>
<div>Higher engagement rate</div>
</div>
</div>
<div class="spacer-medium"></div>
<div class="div-block-52">
<a class="btn_primary is-white w-inline-block" href="https://cal.com/mattia-cs92ne/15min?overlayCalendar=true" target="_blank"><img alt="" class="img_profile is-mattia" loading="lazy" sizes="(max-width: 636px) 100vw, 636px" src="/images/profile.webp" srcset="/images/profile-p-500.webp 500w, /images/profile.webp 636w"/>
<div class="btn-txt_wrap">
<div class="btn-headingg-wrap">
<div class="txt-btn-primary is-price">Book your discovery call</div>
</div>
<div class="btn-subtxt-wrap">
<div>Easy going, zero strings attached</div>
</div>
</div>
</a>
</div>
<div class="spacer-medium"></div>
<div class="wapp_wrap is-hidden-mobile">
<div class="div-block-16">
<a class="btn_primary is-whatsapp w-inline-block" href="https://wa.me/393287365069?text=Hi%20Mattia%2C%20I%27m%20interested%20in%20working%20together%21" target="_blank"><img alt="" class="img_profile" loading="lazy" src="/images/icon_wapp.svg"/>
<div class="btn-txt_wrap">
<div class="btn-headingg-wrap is-secondary">
<div class="txt-btn-primary is-secondary">Prefer to chat?</div>
</div>
<div class="btn-subtxt-wrap is-secondary">
<div>Hit me up!</div>
</div>
</div>
</a>
</div>
</div>
<div class="spacer-huge is-hidden-mobile"></div>
</div>
<div class="book-impact_wrap is-mattia">
<div class="impact-data_wrap is-stroked is-flying is-1">
<div class="arrow_impact-data">↑</div>
<div>130%</div>
</div>
<div class="impact-data_wrap is-stroked is-flying is-3">
<div class="arrow_impact-data">↑</div>
<div>31%</div>
</div>
<div class="impact-data_wrap is-stroked is-flying is-2">
<div class="arrow_impact-data">↑</div>
<div>56%</div>
</div>
</div>
</div>
<Testimonial {...testimonials["joseph-klatt"]} variant="is-book" ix="testimonial-card-book" star="star" />
</div>
<div class="cal-embed_wrap is-mattia">
<div class="highlight_capsule is-mattia">
<div class="is-highlight-capsule">*sorry for the beads</div>
</div>
<div class="mask" data-ix="mask">
<div class="movement" style="-webkit-transform:translate3d(0, -100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, -100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, -100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, -100%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)">
<div class="movement-inverse-2" style="-webkit-transform:translate3d(0, 75%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 75%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 75%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 75%, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)">
<div class="image-size"><img alt="A smiling man with a beard and short hair, wearing a black t-shirt and several wooden bead necklaces, posed against a dark background." class="img_mattia-big" loading="lazy" sizes="100vw" src="/images/mattia_big.webp" srcset="/images/mattia_big-p-500.webp 500w, /images/mattia_big.webp 800w"/></div>
</div>
<div class="overlay" style="display:block"></div>
</div>
</div>
</div>
</div>
</div>
<div class="grid_item is-side is-right"></div>
</div>
</section>
